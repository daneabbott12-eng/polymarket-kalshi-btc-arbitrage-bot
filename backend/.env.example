# Arbitrage model configuration.
# Copy to `.env` and adjust; the backend reads these on startup (defaults shown).
# All are optional — unset values fall back to the defaults below.

# Minimum executable depth (contracts) for an opportunity to count.
ARB_MIN_CONTRACTS=1.0

# Target order size (contracts) used for the realistic order-book-walk analysis.
ARB_TARGET_CONTRACTS=100.0

# Trading fees. Polymarket has no CLOB trading fee; Kalshi charges
# ceil(rate * C * P * (1-P)) per contract.
ARB_KALSHI_FEE_RATE=0.07
ARB_POLYMARKET_FEE_RATE=0.0

# Execution risk (slippage + leg risk).
# Dollars given up per leg to slippage as the book moves before you fill.
ARB_SLIPPAGE_PER_LEG=0.005
# Probability that BOTH legs complete as intended (0-1).
ARB_LEG_FILL_PROBABILITY=0.90
# Dollars lost per contract when a leg is left naked and must be unwound.
ARB_LEG_RISK_LOSS=0.05

# ---------------------------------------------------------------------------
# Auto-runner (auto_runner.py)
# ---------------------------------------------------------------------------
# Base URL of the running backend the runner polls.
ARB_API_BASE=http://localhost:8000
# How often the runner polls for opportunities, in seconds.
AUTO_POLL_SECONDS=3

# ---------------------------------------------------------------------------
# LIVE TRADING (execution_engine.py) — leave OFF unless you know what you're doing
# ---------------------------------------------------------------------------
# Execution mode for the runner:
#   dry_run  (default) — detect + log only, no orders anywhere
#   testnet            — place REAL orders on demo/testnet (fake funds), using the
#                        clients in clients/. Requires the credentials below.
EXECUTION_MODE=dry_run

# Master switch for REAL-MONEY live trading. Even set true, live also requires all
# credentials AND you must implement the order-submission stubs in
# execution_engine.py (they raise until you do). Unset/false => never live.
ARM_LIVE_TRADING=false

# Per-order and open-position safety limits (apply only to the live path).
ARB_MAX_ORDER_CONTRACTS=50
ARB_MAX_OPEN_POSITIONS=5

# Exchange credentials. For EXECUTION_MODE=testnet use your DEMO/testnet creds
# (Kalshi demo API key + a funded Amoy test wallet). Never commit real values.
# KALSHI_PRIVATE_KEY is the RSA private key in PEM form (can be multi-line;
# use a real .env loader or set it as a single escaped line).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_PRIVATE_KEY=

